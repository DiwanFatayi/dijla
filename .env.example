APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://dijla:dijla@postgres:5432/dijla

MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dijla
MINIO_SECRET_KEY=dijla-secret
MINIO_SECURE=false
MINIO_BUCKET_PROOFS=proofs
MINIO_BUCKET_CERTIFICATES=certificates
MINIO_BUCKET_ATTACKS=attacks
MINIO_BUCKET_MODELS=models

LANGGRAPH_CHECKPOINT_BACKEND=postgres

# Set to enable real Anthropic / model backends (sandbox uses mocks if unset)
ANTHROPIC_API_KEY=
